# ---- Model (production = API key) ----
LLM=api
ANTHROPIC_API_KEY=sk-ant-xxxxx
MODEL=claude-sonnet-4-6
# OpenRouter instead of Anthropic:
# OPENROUTER_API_KEY=or-xxxxx
# MODEL=anthropic/claude-sonnet-4.6

# ---- Real-estate inventory (SimplyRETS demo creds are the default; override for real MLS) ----
# SIMPLYRETS_USER=simplyrets
# SIMPLYRETS_PASS=simplyrets

# ---- Persistence (Railway sets DATABASE_URL automatically when you add the Postgres plugin) ----
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATABASE_SSL=true        # set when your Postgres requires SSL (e.g. public proxy URL)

# PORT is provided by Railway. Locally it defaults to 3000.
